<mxfile host="app.diagrams.net">
  <diagram id="net" name="ネットワーク構成">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="&lt;b&gt;LibreChat × RAGFlow 1.0.0 ネットワーク構成（案 v5）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;IPは例示値 / 2026-11-15 時点の設計 / 実機未検証　｜　受信は左→右、送信は上→下&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="900" height="50" as="geometry" />
        </mxCell>

        <!-- ===== Intranet ===== -->
        <mxCell id="zIntra" value="社内イントラネット（10.0.0.0/8）" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="80" width="260" height="560" as="geometry" />
        </mxCell>
        <mxCell id="zChat" value="&lt;b&gt;チャットサービス&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#eef4fc;strokeColor=#6c8ebf;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="35" y="118" width="235" height="152" as="geometry" />
        </mxCell>
        <mxCell id="libre" value="&lt;b&gt;LibreChat サーバー&lt;/b&gt;&lt;br&gt;10.0.0.20 / Entra ID 認証&lt;br&gt;MCP: streamable HTTP&lt;br&gt;customUserVars でユーザー別APIキー&lt;br&gt;NODE_EXTRA_CA_CERTS=rootCA.crt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="160" width="220" height="100" as="geometry" />
        </mxCell>
        <mxCell id="users" value="メンバー・リーダー&lt;br&gt;（社内の任意PC）" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="135" y="300" width="30" height="55" as="geometry" />
        </mxCell>
        <mxCell id="ca" value="&lt;b&gt;自前ルートCA&lt;/b&gt;（オフライン保管）&lt;br&gt;・rootCA.crt を GPO 等で全端末・LibreChat に配布&lt;br&gt;・サーバー証明書 SAN: IP:10.0.0.50&lt;br&gt;・有効期間 397日以内（年1回更新）" style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="35" y="430" width="230" height="110" as="geometry" />
        </mxCell>

        <!-- ===== Host ===== -->
        <mxCell id="zHost" value="ナレッジ管理サーバー（Windows 11 Pro / Hyper-V ホスト）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="80" width="1260" height="560" as="geometry" />
        </mxCell>
        <mxCell id="nic" value="&lt;b&gt;LAN NIC&lt;/b&gt; 10.0.0.50（固定IP）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="320" y="120" width="210" height="40" as="geometry" />
        </mxCell>
        <mxCell id="pp1" value="&lt;b&gt;portproxy ①（MCP）&lt;/b&gt;&lt;br&gt;10.0.0.50:9380 → 192.168.100.10:9380" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#0066CC;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="320" y="180" width="210" height="60" as="geometry" />
        </mxCell>
        <mxCell id="pp3" value="&lt;b&gt;portproxy ③（管理画面）&lt;/b&gt;&lt;br&gt;10.0.0.50:443 → 192.168.100.10:443" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#CC6600;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="320" y="297" width="210" height="60" as="geometry" />
        </mxCell>
        <mxCell id="fw" value="&lt;b&gt;Windows ファイアウォール&lt;/b&gt;&lt;br&gt;9380(10.0.0.50): 送信元 10.0.0.20 のみ&lt;br&gt;443(10.0.0.50): 送信元 10.0.0.0/8&lt;br&gt;443(192.168.100.1): 送信元 VM のみ" style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="320" y="375" width="210" height="80" as="geometry" />
        </mxCell>
        <mxCell id="pp2" value="&lt;b&gt;portproxy ②（送信）&lt;/b&gt;&lt;br&gt;192.168.100.1:443&lt;br&gt;→ myres.openai.azure.com:443" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#009900;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="320" y="492" width="210" height="65" as="geometry" />
        </mxCell>
        <mxCell id="zcc" value="&lt;b&gt;Zscaler Client Connector&lt;/b&gt;&lt;br&gt;Z-Tunnel 2.0（ホスト発通信を捕捉）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="320" y="577" width="210" height="50" as="geometry" />
        </mxCell>
        <mxCell id="vsw" value="&lt;b&gt;Hyper-V&lt;br&gt;内部スイッチ&lt;/b&gt;&lt;br&gt;RagInternal&lt;br&gt;&lt;br&gt;vEthernet&lt;br&gt;192.168.100.1&lt;br&gt;/24&lt;br&gt;&lt;br&gt;NATなし" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="555" y="120" width="90" height="505" as="geometry" />
        </mxCell>

        <!-- ===== VM ===== -->
        <mxCell id="zVM" value="Ubuntu Server VM　192.168.100.10/24（GW・DNSなし）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="670" y="110" width="870" height="515" as="geometry" />
        </mxCell>

        <!-- ingress network -->
        <mxCell id="zIn" value="&lt;b&gt;ingress&lt;/b&gt; ネットワーク（受信用）&lt;br&gt;ポート公開 9380 / 443" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#dae8fc;strokeColor=#0066CC;verticalAlign=top;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="690" y="145" width="250" height="255" as="geometry" />
        </mxCell>
        <mxCell id="nginx" value="&lt;b&gt;nginx（TLS終端）&lt;/b&gt;&lt;br&gt;自前CA証明書（IP:10.0.0.50）&lt;br&gt;:9380 → POST /api/v1/mcp のみ&lt;br&gt;:443 → 管理画面&lt;br&gt;それ以外は 404&lt;br&gt;&lt;i&gt;＋ rag-internal にも接続&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0066CC;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="705" y="180" width="220" height="165" as="geometry" />
        </mxCell>

        <!-- rag-internal network -->
        <mxCell id="zInt" value="&lt;b&gt;rag-internal&lt;/b&gt; ネットワーク（internal: true）" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="965" y="145" width="555" height="255" as="geometry" />
        </mxCell>
        <mxCell id="ragflow" value="&lt;b&gt;RAGFlow 1.0.0&lt;/b&gt;&lt;br&gt;API :9380（MCP: /api/v1/mcp）/ 画面&lt;br&gt;ホストへのポート公開なし&lt;br&gt;自己登録 有効&lt;br&gt;HTTPS_PROXY=squid:3128&lt;br&gt;Zscaler ルート証明書を導入" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=2;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="985" y="202" width="250" height="120" as="geometry" />
        </mxCell>
        <mxCell id="deps" value="&lt;b&gt;依存サービス&lt;/b&gt;&lt;br&gt;MySQL / MinIO / Redis / 検索エンジン&lt;br&gt;（NO_PROXY 対象）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1260" y="202" width="240" height="120" as="geometry" />
        </mxCell>
        <mxCell id="blocked" value="✕ 直接の外部通信は不可（VMにGWなし＋internal ネットワーク）" style="text;html=1;align=left;verticalAlign=middle;fontColor=#CC0000;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="985" y="345" width="480" height="30" as="geometry" />
        </mxCell>

        <!-- egress network -->
        <mxCell id="zOut" value="&lt;b&gt;egress&lt;/b&gt; ネットワーク（送信用・ポート公開なし）" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#e6f2e6;strokeColor=#009900;verticalAlign=top;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="965" y="430" width="555" height="180" as="geometry" />
        </mxCell>
        <mxCell id="squid" value="&lt;b&gt;squid&lt;/b&gt; :3128&lt;br&gt;許可: myres.openai.azure.com:443 のみ&lt;br&gt;extra_hosts で FQDN → 192.168.100.1&lt;br&gt;&lt;i&gt;＋ rag-internal にも接続&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#009900;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="985" y="480" width="250" height="90" as="geometry" />
        </mxCell>

        <!-- ===== Internet (bottom) ===== -->
        <mxCell id="zCloud" value="インターネット / クラウド" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="680" width="1540" height="220" as="geometry" />
        </mxCell>
        <mxCell id="entra" value="&lt;b&gt;Microsoft Entra ID&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="50" y="745" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="zcloud" value="&lt;b&gt;Zscaler クラウド&lt;/b&gt;&lt;br&gt;TLS検査（復号・再署名）&lt;br&gt;※ 検査除外は不可の想定" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="315" y="715" width="220" height="130" as="geometry" />
        </mxCell>
        <mxCell id="aoai" value="&lt;b&gt;Azure OpenAI&lt;/b&gt;&lt;br&gt;myres.openai.azure.com&lt;br&gt;埋め込みモデル（RAGFlow用）／チャットモデル（LibreChat用）&lt;br&gt;IP制限・Private Endpoint なし&lt;br&gt;利用量アラート／クォータ推奨" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="700" y="725" width="300" height="110" as="geometry" />
        </mxCell>

        <!-- ===== Inbound ===== -->
        <mxCell id="e1" value="① MCP HTTPS&lt;br&gt;Bearer APIキー（ユーザー別）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0066CC;strokeWidth=2;fontSize=10;fontColor=#0066CC;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="libre" target="pp1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12" value="③ 管理画面 HTTPS&lt;br&gt;登録・招待・APIキー発行" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#CC6600;strokeWidth=2;fontSize=10;fontColor=#CC6600;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="users" target="pp3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value=":9380" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0066CC;strokeWidth=2;fontSize=10;fontColor=#0066CC;exitX=1;exitY=0.5;entryX=0;entryY=0.182;" edge="1" parent="1" source="pp1" target="nginx">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e13" value=":443" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#CC6600;strokeWidth=2;fontSize=10;fontColor=#CC6600;exitX=1;exitY=0.5;entryX=0;entryY=0.891;" edge="1" parent="1" source="pp3" target="nginx">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3b" value="受信（MCP・画面）&lt;br&gt;HTTP ragflow:9380 / :80" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0066CC;strokeWidth=3;fontSize=10;fontColor=#0066CC;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="nginx" target="ragflow">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== Outbound ===== -->
        <mxCell id="e4" value="送信（埋め込み）&lt;br&gt;② CONNECT squid:3128" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#009900;strokeWidth=3;fontSize=10;fontColor=#009900;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="ragflow" target="squid">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="192.168.100.1:443" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#009900;strokeWidth=2;fontSize=10;fontColor=#009900;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="squid" target="pp2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="ホスト発通信" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#009900;strokeWidth=2;fontSize=10;fontColor=#009900;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="pp2" target="zcc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="Z-Tunnel 2.0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#009900;strokeWidth=2;fontSize=10;fontColor=#009900;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="zcc" target="zcloud">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="HTTPS（埋め込み）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#009900;strokeWidth=2;fontSize=10;fontColor=#009900;exitX=0.875;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="zcloud" target="aoai">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== Intranet-side others ===== -->
        <mxCell id="e11" value="チャット HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;fontSize=10;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="users" target="libre">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e14" value="rootCA.crt 配布" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;strokeColor=#B09500;fontSize=10;fontColor=#B09500;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="ca" target="users">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" value="ユーザー認証" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;strokeColor=#666666;fontSize=10;exitX=0;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="libre" target="entra">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="27" y="190" />
              <mxPoint x="27" y="775" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e9" value="LLM 呼び出し（既存経路）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;strokeColor=#666666;fontSize=10;exitX=0;exitY=0.7;entryX=0.5;entryY=1;" edge="1" parent="1" source="libre" target="aoai">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="10" y="230" />
              <mxPoint x="10" y="880" />
              <mxPoint x="850" y="880" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- ===== Legend & notes ===== -->
        <mxCell id="legend" value="&lt;b&gt;凡例&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#0066CC&quot;&gt;━ ① 検索（LibreChat → nginx → RAGFlow）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#CC6600&quot;&gt;━ ③ 管理画面（社内PC → nginx → RAGFlow）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#009900&quot;&gt;━ ② 埋め込み（RAGFlow → squid → ホスト → Azure OpenAI）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;┅ 既存の LibreChat 通信（経路詳細は未確認）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#B09500&quot;&gt;┅ 自前ルートCA の配布&lt;/font&gt;&lt;br&gt;太線：RAGFlow 視点の受信（左）・送信（下）" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="930" width="420" height="125" as="geometry" />
        </mxCell>
        <mxCell id="notes" value="&lt;b&gt;要検証・運用上の注意（推測・未確認事項）&lt;/b&gt;&lt;br&gt;・自己登録：10.x の誰でも登録・文書登録可 → Azure OpenAI の利用量アラート／クォータ、VMディスク監視、利用規程&lt;br&gt;・1.0.0 の画面ポート、サービス名、自己登録の設定名（旧版は REGISTER_ENABLED）&lt;br&gt;・証明書は IP 前提：ホストIP固定、397日以内で年1回更新、Firefox は企業ポリシーでOS証明書ストアを使用&lt;br&gt;・管理画面経路では /api/v1/* 全体が通る（MCP経路のパス制限は LibreChat 経由の操作を絞る効果のみ）&lt;br&gt;・portproxy の FQDN 名前解決タイミング（Azure 側 IP 変更への追従）&lt;br&gt;・RAGFlow がシステム信頼ストアを参照するか（SSL_CERT_FILE 等）&lt;br&gt;・ホスト再起動後、未ログオンでも ZCC・portproxy が通信可能か&lt;br&gt;・Zscaler の DLP／サイズ制限、ナレッジ本文と APIキーの復号の社内規程上の可否&lt;br&gt;・イメージは構築時に別端末で取得し docker save / load で持ち込み（apt パッケージの入手方法は別途）" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="460" y="930" width="1100" height="180" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
